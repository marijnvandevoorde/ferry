        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya puede enviar fotos a este Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ora può inviare foto a questo Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann jetzt Fotos an diesen Mac senden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan nu foto's naar deze Mac sturen."
          }
