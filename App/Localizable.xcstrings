    "Mark them as imported, and Import New will only pick up photos you take from now on. Nothing is copied or deleted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez-les comme importées : « Importer les nouvelles » ne prendra plus que les photos que vous prendrez désormais. Rien n'est copié ni supprimé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Márcalas como importadas e «Importar nuevas» solo recogerá las fotos que hagas a partir de ahora. No se copia ni se borra nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnale come importate e «Importa nuove» prenderà solo le foto che scatterai da ora in poi. Niente viene copiato o eliminato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere sie als importiert, dann holt „Neue importieren“ nur noch Fotos, die du ab jetzt machst. Es wird nichts kopiert oder gelöscht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer ze als geïmporteerd, dan haalt ‘Nieuwe importeren’ alleen nog foto's op die je vanaf nu maakt. Er wordt niets gekopieerd of verwijderd."
          }
        }
      }
    },
