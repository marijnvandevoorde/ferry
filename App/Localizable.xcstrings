          }
        }
      }
    },
    "Oldest First": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus anciennes d'abord"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más antiguas primero"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più vecchie prima"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
