            "state": "translated",
            "value": "Warten auf die Kamera"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op de camera"
          }
        }
      }
    },
    "Waiting for the camera to send images…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente des images de l'appareil…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando a que la cámara envíe imágenes…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa che la fotocamera invii le immagini…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte, bis die Kamera Bilder sendet…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten tot de camera beelden stuurt…"
          }
        }
      }
    },
    "Where is Wi-Fi on my camera?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où se trouve le Wi-Fi sur mon appareil ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dónde está el Wi-Fi en mi cámara?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dov'è il Wi-Fi sulla mia fotocamera?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo finde ich das WLAN an meiner Kamera?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waar zit wifi op mijn camera?"
          }
        }
      }
    },
    "While this Mac is on the camera's network it has no internet. Turn the camera off and this Mac goes back to your usual Wi-Fi.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que ce Mac est sur le réseau de l'appareil, il n'a pas d'internet. Éteignez l'appareil et ce Mac revient sur votre Wi-Fi habituel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras este Mac esté en la red de la cámara no tendrá internet. Apaga la cámara y este Mac vuelve a tu Wi-Fi habitual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché questo Mac è sulla rete della fotocamera non ha internet. Spegni la fotocamera e questo Mac torna al tuo Wi-Fi abituale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dieser Mac im Netzwerk der Kamera ist, hat er kein Internet. Schalte die Kamera aus, und dieser Mac wechselt zurück in dein übliches WLAN."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang deze Mac op het netwerk van de camera zit, heeft hij geen internet. Zet de camera uit en deze Mac gaat terug naar je gewone wifi."
          }
        }
      }
    },
