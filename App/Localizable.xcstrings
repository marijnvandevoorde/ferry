    "Fuji Import connects automatically. Press **OK** on the camera if it asks.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import se connecte automatiquement. Appuyez sur **OK** sur l'appareil s'il le demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import se conecta automáticamente. Pulsa **OK** en la cámara si te lo pide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import si collega automaticamente. Premi **OK** sulla fotocamera se lo chiede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import verbindet sich automatisch. Drücke **OK** an der Kamera, wenn sie fragt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import maakt automatisch verbinding. Druk op **OK** op de camera als die erom vraagt."
          }
        }
      }
    },
    "Fuji Import needs access to Photos. Allow it in System Settings → Privacy & Security → Photos.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import a besoin d'accéder à Photos. Autorisez-le dans Réglages Système → Confidentialité et sécurité → Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import necesita acceso a Fotos. Permítelo en Ajustes del Sistema → Privacidad y seguridad → Fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import ha bisogno di accedere a Foto. Consentilo in Impostazioni di Sistema → Privacy e sicurezza → Foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import braucht Zugriff auf Fotos. Erlaube ihn in Systemeinstellungen → Datenschutz & Sicherheit → Fotos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import heeft toegang tot Foto's nodig. Sta dit toe in Systeeminstellingen → Privacy en beveiliging → Foto's."
          }
        }
      }
    },
    "Fuji Import remembers which photos it imported so it only offers new ones.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import retient les photos déjà importées pour ne proposer que les nouvelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import recuerda qué fotos importó para ofrecer solo las nuevas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import ricorda quali foto ha importato per proporre solo quelle nuove."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import merkt sich, welche Fotos importiert wurden, und bietet nur neue an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import onthoudt welke foto's het geïmporteerd heeft en biedt alleen nieuwe aan."
          }
