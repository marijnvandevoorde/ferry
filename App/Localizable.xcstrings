    "Not enough free space: the import needs %@ but only %@ is free on the disk of “%@”.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace insuffisant : l'importation nécessite %@ mais seuls %@ sont libres sur le disque de « %@ »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente: la importación necesita %@ pero solo hay %@ libres en el disco de «%@»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente: l'importazione richiede %@ ma solo %@ sono liberi sul disco di «%@»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicherplatz: Der Import braucht %1$@, aber auf dem Laufwerk von „%3$@“ sind nur %2$@ frei."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg vrije ruimte: het importeren heeft %@ nodig, maar er is maar %@ vrij op de schijf van ‘%@’."
          }
        }
      }
    },
    "Not in pairing mode": {
      "localizations": {
        "fr": {
