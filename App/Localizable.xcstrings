    "Example: %@. For Lightroom Classic, pick the folder that Auto Import watches; for Capture One, its hot folder. Tokens: {yyyy} {MM} {dd} {HH} {mm} {ss} {camera} {original}.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple : %@. Pour Lightroom Classic, choisissez le dossier surveillé par l'importation automatique ; pour Capture One, son dossier actif. Jetons : {yyyy} {MM} {dd} {HH} {mm} {ss} {camera} {original}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: %@. Para Lightroom Classic, elige la carpeta que vigila la importación automática; para Capture One, su carpeta activa. Variables: {yyyy} {MM} {dd} {HH} {mm} {ss} {camera} {original}."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esempio: %@. Per Lightroom Classic, scegli la cartella controllata dall'importazione automatica; per Capture One, la sua hot folder. Variabili: {yyyy} {MM} {dd} {HH} {mm} {ss} {camera} {original}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispiel: %@. Für Lightroom Classic den Ordner wählen, den der automatische Import überwacht; für Capture One den Hotfolder. Platzhalter: {yyyy} {MM} {dd} {HH} {mm} {ss} {camera} {original}."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld: %@. Kies voor Lightroom Classic de map die automatisch importeren bewaakt; voor Capture One de hotfolder. Variabelen: {yyyy} {MM} {dd} {HH} {mm} {ss} {camera} {original}."
          }
        }
      }
    },
    "Ferry": {
      "shouldTranslate": false
    },
    "Ferry can't access the %@ “%@”. Choose it again in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry ne peut pas accéder au %@ « %@ ». Choisissez-le à nouveau dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry no puede acceder a la %@ «%@». Vuelve a elegirla en Ajustes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry non può accedere alla %@ «%@». Sceglila di nuovo nelle impostazioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry kann nicht auf den %@ „%@“ zugreifen. Wähle ihn in den Einstellungen erneut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry heeft geen toegang tot de %@ ‘%@’. Kies hem opnieuw bij Instellingen."
          }
        }
      }
    },
    "Ferry connects automatically. Press **OK** on the camera if it asks.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry se connecte automatiquement. Appuyez sur **OK** sur l'appareil s'il le demande."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry se conecta automáticamente. Pulsa **OK** en la cámara si te lo pide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry si collega automaticamente. Premi **OK** sulla fotocamera se lo chiede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry verbindet sich automatisch. Drücke **OK** an der Kamera, wenn sie fragt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry maakt automatisch verbinding. Druk op **OK** op de camera als die erom vraagt."
          }
        }
      }
    },
    "Ferry lets go of the camera after the import. Turn the camera off and this Mac goes back to your usual Wi-Fi.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry libère l'appareil après l'import. Éteignez l'appareil et ce Mac revient sur votre Wi-Fi habituel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry suelta la cámara al terminar la importación. Apaga la cámara y este Mac vuelve a tu Wi-Fi habitual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry lascia la fotocamera dopo l'importazione. Spegni la fotocamera e questo Mac torna al tuo Wi-Fi abituale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry gibt die Kamera nach dem Import frei. Schalte die Kamera aus, und dieser Mac wechselt zurück in dein übliches WLAN."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry laat de camera los na het importeren. Zet de camera uit en deze Mac gaat terug naar je gewone wifi."
          }
        }
      }
    },
    "Ferry needs access to Photos. Allow it in System Settings → Privacy & Security → Photos.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry a besoin d'accéder à Photos. Autorisez-le dans Réglages Système → Confidentialité et sécurité → Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry necesita acceso a Fotos. Permítelo en Ajustes del Sistema → Privacidad y seguridad → Fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry ha bisogno di accedere a Foto. Consentilo in Impostazioni di Sistema → Privacy e sicurezza → Foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry braucht Zugriff auf Fotos. Erlaube ihn in Systemeinstellungen → Datenschutz & Sicherheit → Fotos."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry heeft toegang tot Foto's nodig. Sta dit toe in Systeeminstellingen → Privacy en beveiliging → Foto's."
          }
        }
      }
    },
    "Ferry remembers which photos it imported so it only offers new ones.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry retient les photos déjà importées pour ne proposer que les nouvelles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry recuerda qué fotos importó para ofrecer solo las nuevas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry ricorda quali foto ha importato per proporre solo quelle nuove."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry merkt sich, welche Fotos importiert wurden, und bietet nur neue an."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry onthoudt welke foto's het geïmporteerd heeft en biedt alleen nieuwe aan."
          }
        }
      }
    },
