            "value": "Fuji Import ne peut pas accéder au %@ « %@ ». Choisissez-le à nouveau dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuji Import no puede acceder a la %@ «%@». Vuelve a elegirla en Ajustes."
