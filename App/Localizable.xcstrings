    "The %@ “%@” isn't available. Is the drive connected?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le %@ « %@ » n'est pas disponible. Le disque est-il connecté ?"
          }
        },
