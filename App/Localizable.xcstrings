    "All photos on the camera will show as not imported. Nothing is deleted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les photos de l'appareil apparaîtront comme non importées. Rien n'est supprimé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las fotos de la cámara aparecerán como no importadas. No se borra nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le foto della fotocamera risulteranno non importate. Non viene eliminato nulla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Fotos auf der Kamera erscheinen als nicht importiert. Es wird nichts gelöscht."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle foto's op de camera verschijnen als niet geïmporteerd. Er wordt niets verwijderd."
          }
        }
      }
    },
