    "**Canon:** the Wi-Fi menu, as for the Camera Connect app.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Canon :** le menu Wi-Fi, comme pour l'app Camera Connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Canon:** el menú Wi-Fi, como para la app Camera Connect."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Canon:** il menu Wi-Fi, come per l'app Camera Connect."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Canon:** das WLAN-Menü, wie für die App Camera Connect."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Canon:** het wifimenu, zoals voor de app Camera Connect."
          }
        }
      }
    },
    "**Fujifilm:** Playback, then Wireless Communication (on some models the Wi-Fi button).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fujifilm :** Lecture, puis Communication sans fil (sur certains modèles, le bouton Wi-Fi)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fujifilm:** Reproducción y luego Comunicación inalámbrica (en algunos modelos, el botón Wi-Fi)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fujifilm:** Riproduzione, poi Comunicazione wireless (su alcuni modelli il tasto Wi-Fi)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fujifilm:** Wiedergabe, dann Drahtlose Kommunikation (bei manchen Modellen die WLAN-Taste)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Fujifilm:** Weergave, dan Draadloze communicatie (op sommige modellen de wifiknop)."
          }
        }
      }
    },
    "**GoPro:** Preferences → Connections → Connect Device → GoPro Quik. The network name and password are under Camera Info.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**GoPro :** Préférences → Connexions → Connecter l'appareil → GoPro Quik. Le nom du réseau et le mot de passe sont dans Infos caméra."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**GoPro:** Preferencias → Conexiones → Conectar dispositivo → GoPro Quik. El nombre de la red y la contraseña están en Información de la cámara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**GoPro:** Preferenze → Connessioni → Collega dispositivo → GoPro Quik. Nome della rete e password sono in Info fotocamera."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**GoPro:** Einstellungen → Verbindungen → Gerät verbinden → GoPro Quik. Netzwerkname und Passwort stehen unter Kamerainfo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**GoPro:** Voorkeuren → Verbindingen → Apparaat verbinden → GoPro Quik. De netwerknaam en het wachtwoord staan onder Camera-info."
          }
        }
      }
    },
