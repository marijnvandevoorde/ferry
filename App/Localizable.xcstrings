        }
      }
    },
    "Not tested on a real camera yet. If you try it, please tell us whether it worked.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore testé sur un vrai appareil. Si vous l'essayez, dites-nous si ça a marché."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha probado con una cámara real. Si lo pruebas, cuéntanos si funcionó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora provato su una fotocamera reale. Se lo provi, facci sapere se ha funzionato."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht an einer echten Kamera getestet. Wenn du es ausprobierst, sag uns bitte, ob es geklappt hat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet getest op een echte camera. Probeer je het, laat ons dan weten of het werkte."
          }
        }
      }
    },
    "Nothing new to bring across": {
      "localizations": {
