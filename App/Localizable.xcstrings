    "Filter and sort. Import New imports what the filters show.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrer et trier. « Importer les nouvelles » importe ce que montrent les filtres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrar y ordenar. «Importar nuevas» importa lo que muestran los filtros."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtra e ordina. «Importa nuove» importa ciò che mostrano i filtri."
          }
        },
