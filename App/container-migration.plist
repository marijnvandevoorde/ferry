<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Moves data from the unsandboxed 0.1 build into the sandbox container on first launch. -->
<plist version="1.0">
<dict>
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/FujiImport</string>
		<string>${Library}/Preferences/io.github.fujiimport.FujiImport.plist</string>
	</array>
</dict>
</plist>
