{
  "sourceLanguage": "en",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry pairs with newer Fujifilm cameras over Bluetooth to start their Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry s'appaire en Bluetooth avec les appareils Fujifilm récents pour démarrer leur Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry se empareja por Bluetooth con las cámaras Fujifilm más nuevas para activar su Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry si abbina via Bluetooth alle fotocamere Fujifilm più recenti per avviarne il Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry koppelt sich per Bluetooth mit neueren Fujifilm-Kameras, um ihr WLAN zu starten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry koppelt via Bluetooth met nieuwere Fujifilm-camera's om hun wifi te starten."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry connects to your camera over its Wi-Fi network to read and download photos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry se connecte à votre appareil via son réseau Wi-Fi pour lire et télécharger les photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry se conecta a tu cámara por su red Wi-Fi para leer y descargar fotos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry si collega alla fotocamera tramite la sua rete Wi-Fi per leggere e scaricare le foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry verbindet sich über das WLAN der Kamera, um Fotos zu lesen und herunterzuladen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry maakt via het wifinetwerk van de camera verbinding om foto's te lezen en te downloaden."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry adds the photos you import to an album in your library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry ajoute les photos importées à un album de votre photothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry añade las fotos que importas a un álbum de tu fototeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry aggiunge le foto importate a un album della tua libreria."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry fügt importierte Fotos einem Album in deiner Mediathek hinzu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry voegt geïmporteerde foto's toe aan een album in je bibliotheek."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry saves photos from your camera to your Photos library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry enregistre les photos de votre appareil dans votre photothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry guarda las fotos de tu cámara en tu fototeca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry salva le foto della fotocamera nella tua libreria Foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry sichert Fotos deiner Kamera in deiner Fotos-Mediathek."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferry bewaart foto's van je camera in je Foto's-bibliotheek."
          }
        }
      }
    },
    "CFBundleDisplayName": {
      "shouldTranslate": false
    },
    "CFBundleName": {
      "shouldTranslate": false
    }
  },
  "version": "1.0"
}